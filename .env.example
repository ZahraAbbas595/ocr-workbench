# Copy this file to a new file named ".env" and fill in your real values.
# The real ".env" file is SECRET and must NEVER be committed to Git.

# Azure settings 
AZURE_DOC_INTEL_ENDPOINT=your-endpoint-here
AZURE_DOC_INTEL_KEY=your-key-here

# Windows paths to the tools installed
# Only needed on Windows, where Tesseract/Poppler aren't on system PATH.
# Leave unset on Linux/Mac if installed via a package manager (apt, brew, etc).
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=C:\poppler\poppler-26.02.0\Library\bin